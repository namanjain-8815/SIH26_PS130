// Data model per IMPLEMENTATION_PLAN.md §5 (MVP-trimmed: Establishment
// folded into Project, RegulationVersion replaced by effective_from/to on
// the rule row, Grievance/Escalation dropped for MVP).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ENTREPRENEUR
  MANAGER
  OFFICER
  NODAL
  INSPECTOR
  ADMIN
}

enum ProjectApprovalStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

// Application lifecycle per plan §18
enum ApplicationStatus {
  NOT_STARTED
  READY_TO_START
  IN_PREPARATION
  SUBMITTED
  UNDER_REVIEW
  QUERY_RAISED
  INSPECTION_PENDING
  INSPECTION_SCHEDULED
  AWAITING_APPLICANT
  AWAITING_DEPARTMENT
  APPROVED
  REJECTED
  CLOSED
}

enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ApplicationDocValidationStatus {
  PENDING
  VALID
  INVALID
}

enum QueryStatus {
  OPEN
  RESPONDED
  UNDER_REVIEW
  RESOLVED
  ESCALATED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SLAStatus {
  ON_TRACK
  AT_RISK
  BREACHED
  COMPLETED
}

enum IncentiveMatchStatus {
  POTENTIALLY_ELIGIBLE
  NOT_ELIGIBLE
  APPLIED
}

enum ComplianceStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
}

enum DependencyType {
  PREREQUISITE
  PARALLEL_OK
  OPTIONAL
}

// ---------------------------------------------------------------------------
// Core / identity
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role
  org_id        String?
  department_id String?
  status        String   @default("active")
  created_at    DateTime @default(now())

  organization       Organization?      @relation(fields: [org_id], references: [id])
  department         Department?        @relation(fields: [department_id], references: [id])
  application_events ApplicationEvent[]
  audit_logs         AuditLog[]
  notifications      Notification[]
  queries_created    Query[]            @relation("QueryCreatedBy")
  queries_assigned   Query[]            @relation("QueryAssignedTo")
  query_responses    QueryResponse[]
  inspections        Inspection[]       @relation("InspectorUser")
}

model Organization {
  id          String   @id @default(uuid())
  legal_name  String
  entity_type String
  sector      String
  created_at  DateTime @default(now())

  users     User[]
  projects  Project[]
  documents Document[]
}

model Department {
  id       String @id @default(uuid())
  name     String
  state    String
  district String

  officers     User[]
  applications Application[]
  inspections  Inspection[]
}

// ---------------------------------------------------------------------------
// Project
// ---------------------------------------------------------------------------

model Project {
  id                String    @id @default(uuid())
  org_id            String
  name              String
  type              String?
  sector            String
  investment_amount Decimal   @db.Decimal(14, 2)
  employee_count    Int
  stage             String
  district          String
  industrial_area   String?
  address           String?
  target_start_date DateTime?
  created_at        DateTime  @default(now())

  organization            Organization            @relation(fields: [org_id], references: [id])
  attributes              ProjectAttribute[]
  project_approvals       ProjectApproval[]
  documents               Document[]
  incentive_matches       IncentiveMatch[]
  compliance_requirements ComplianceRequirement[]
}

model ProjectAttribute {
  id         String @id @default(uuid())
  project_id String
  key        String
  value      String

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([project_id, key])
}

// ---------------------------------------------------------------------------
// Regulatory knowledge engine (plan §13-15)
// ---------------------------------------------------------------------------

model ApprovalType {
  id                  String   @id @default(uuid())
  name                String
  authority           String
  category            String
  description         String
  purpose             String
  default_sla_days    Int
  renewal_period_days Int?
  requires_inspection Boolean  @default(false)
  source_reference    String?
  active              Boolean  @default(true)
  created_at          DateTime @default(now())

  applicability_rules   ApplicabilityRule[]
  document_requirements DocumentRequirement[]
  project_approvals     ProjectApproval[]
  sla_policies          SLAPolicy[]
  prerequisite_for      ApprovalDependency[]  @relation("PrerequisiteApproval")
  dependent_on          ApprovalDependency[]  @relation("DependentApproval")
}

// conditions: RuleCondition[] JSON, see rule-engine/types.ts — keep this a
// dumb {field, operator, value} AND-group, never an expression language.
model ApplicabilityRule {
  id               String    @id @default(uuid())
  approval_type_id String
  rule_name        String
  conditions       Json
  jurisdiction     String
  sector           String?
  effective_from   DateTime  @default(now())
  effective_to     DateTime?
  source_reference String?
  active           Boolean   @default(true)

  approval_type ApprovalType @relation(fields: [approval_type_id], references: [id], onDelete: Cascade)
}

model ApprovalDependency {
  id                            String         @id @default(uuid())
  prerequisite_approval_type_id String
  dependent_approval_type_id    String
  dependency_type               DependencyType @default(PREREQUISITE)

  prerequisite_approval ApprovalType @relation("PrerequisiteApproval", fields: [prerequisite_approval_type_id], references: [id])
  dependent_approval    ApprovalType @relation("DependentApproval", fields: [dependent_approval_type_id], references: [id])

  @@unique([prerequisite_approval_type_id, dependent_approval_type_id])
}

model ProjectApproval {
  id                     String                @id @default(uuid())
  project_id             String
  approval_type_id       String
  applicability_reason   String
  status                 ProjectApprovalStatus @default(NOT_STARTED)
  priority               Priority              @default(MEDIUM)
  due_date               DateTime?
  actual_completion_date DateTime?
  blocked_reason         String?
  created_at             DateTime              @default(now())

  project       Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  approval_type ApprovalType @relation(fields: [approval_type_id], references: [id])
  application   Application?

  @@unique([project_id, approval_type_id])
}

model DocumentRequirement {
  id               String  @id @default(uuid())
  approval_type_id String
  document_type    String
  mandatory        Boolean @default(true)
  condition        String?

  approval_type ApprovalType @relation(fields: [approval_type_id], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Documents (plan §16-17)
// ---------------------------------------------------------------------------

model Document {
  id                  String                     @id @default(uuid())
  org_id              String
  project_id          String
  document_type       String
  file_name           String
  file_url            String
  version             Int                        @default(1)
  verification_status DocumentVerificationStatus @default(PENDING)
  issued_date         DateTime?
  expiry_date         DateTime?
  created_at          DateTime                   @default(now())

  organization          Organization          @relation(fields: [org_id], references: [id])
  project               Project               @relation(fields: [project_id], references: [id], onDelete: Cascade)
  application_documents ApplicationDocument[]
}

// ---------------------------------------------------------------------------
// Applications, events, queries, inspections (plan §18, §21-22)
// ---------------------------------------------------------------------------

model Application {
  id                  String            @id @default(uuid())
  project_approval_id String            @unique
  department_id       String
  application_number  String            @unique
  status              ApplicationStatus @default(NOT_STARTED)
  submitted_at        DateTime?
  due_date            DateTime?
  completed_at        DateTime?
  created_at          DateTime          @default(now())

  project_approval      ProjectApproval       @relation(fields: [project_approval_id], references: [id], onDelete: Cascade)
  department            Department            @relation(fields: [department_id], references: [id])
  application_documents ApplicationDocument[]
  events                ApplicationEvent[]
  queries               Query[]
  inspections           Inspection[]
  sla_instance          SLAInstance?
}

model ApplicationDocument {
  id                String                         @id @default(uuid())
  application_id    String
  document_id       String
  validation_status ApplicationDocValidationStatus @default(PENDING)
  validation_notes  String?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  document    Document    @relation(fields: [document_id], references: [id])

  @@unique([application_id, document_id])
}

model ApplicationEvent {
  id             String   @id @default(uuid())
  application_id String
  actor_id       String?
  event_type     String
  timestamp      DateTime @default(now())
  notes          String?
  metadata       Json?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actor_id], references: [id])
}

model Query {
  id             String      @id @default(uuid())
  application_id String
  created_by     String
  assigned_to    String?
  subject        String
  description    String
  priority       Priority    @default(MEDIUM)
  deadline       DateTime?
  status         QueryStatus @default(OPEN)
  created_at     DateTime    @default(now())

  application Application     @relation(fields: [application_id], references: [id], onDelete: Cascade)
  creator     User            @relation("QueryCreatedBy", fields: [created_by], references: [id])
  assignee    User?           @relation("QueryAssignedTo", fields: [assigned_to], references: [id])
  responses   QueryResponse[]
}

model QueryResponse {
  id            String   @id @default(uuid())
  query_id      String
  created_by    String
  response_text String
  created_at    DateTime @default(now())

  query  Query @relation(fields: [query_id], references: [id], onDelete: Cascade)
  author User  @relation(fields: [created_by], references: [id])
}

model Inspection {
  id             String           @id @default(uuid())
  application_id String
  department_id  String
  inspector_id   String?
  scheduled_date DateTime
  status         InspectionStatus @default(SCHEDULED)
  location       String?
  purpose        String?
  created_at     DateTime         @default(now())

  application Application         @relation(fields: [application_id], references: [id], onDelete: Cascade)
  department  Department          @relation(fields: [department_id], references: [id])
  inspector   User?               @relation("InspectorUser", fields: [inspector_id], references: [id])
  findings    InspectionFinding[]
}

model InspectionFinding {
  id                String          @id @default(uuid())
  inspection_id     String
  severity          FindingSeverity
  description       String
  corrective_action String?
  status            String          @default("open")

  inspection Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// SLA (plan §19)
// ---------------------------------------------------------------------------

model SLAPolicy {
  id               String  @id @default(uuid())
  approval_type_id String
  duration_days    Int
  start_event      String
  escalation_level String?

  approval_type ApprovalType @relation(fields: [approval_type_id], references: [id], onDelete: Cascade)
}

model SLAInstance {
  id              String    @id @default(uuid())
  application_id  String    @unique
  due_date        DateTime
  status          SLAStatus @default(ON_TRACK)
  breached        Boolean   @default(false)
  breach_duration Int?

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Incentives + compliance/renewals (plan §23-24)
// ---------------------------------------------------------------------------

// eligibility_rules: RuleCondition[] JSON — same shape as
// ApplicabilityRule.conditions, so regulatoryService reuses the same
// evaluator for incentive matching (plan §23).
model IncentiveScheme {
  id                  String    @id @default(uuid())
  name                String
  authority           String
  description         String
  eligibility_rules   Json
  benefit_description String
  deadline            DateTime?
  source_reference    String?
  created_at          DateTime  @default(now())

  matches IncentiveMatch[]
}

model IncentiveMatch {
  id                  String               @id @default(uuid())
  project_id          String
  incentive_scheme_id String
  matching_reasons    Json
  status              IncentiveMatchStatus @default(POTENTIALLY_ELIGIBLE)
  created_at          DateTime             @default(now())

  project          Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  incentive_scheme IncentiveScheme @relation(fields: [incentive_scheme_id], references: [id])

  @@unique([project_id, incentive_scheme_id])
}

model ComplianceRequirement {
  id                 String           @id @default(uuid())
  project_id         String
  name               String
  authority          String
  frequency          String
  next_due_date      DateTime
  status             ComplianceStatus @default(UPCOMING)
  linked_approval_id String?
  created_at         DateTime         @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Audit + notifications (plan §34, §39)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  actor_id    String?
  action      String
  entity_type String
  entity_id   String
  timestamp   DateTime @default(now())
  before_data Json?
  after_data  Json?
  metadata    Json?

  actor User? @relation(fields: [actor_id], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
